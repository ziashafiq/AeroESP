DJANGO_ENV=production
DJANGO_DEBUG=0

DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com


# postgresql (default) or sqlite
AEROESP_DB_BACKEND=postgresql

AEROESP_DB_NAME=aeroesp_production
AEROESP_DB_USER=aeroesp_prod_user
AEROESP_DB_PASSWORD=
AEROESP_DB_HOST=127.0.0.1
AEROESP_DB_PORT=5432


AEROESP_SECRET_KEY=


AEROESP_AI_PROVIDER=BASELINE_V1

AEROESP_OPENAI_MODEL=
AEROESP_DEEPSEEK_MODEL=deepseek-chat


# =========================================================
# Email (REQUIRED - account verification codes depend on it)
# =========================================================
#
# Recommended provider: Brevo (free tier, 300 emails/day).
#
#   1. Create an account at https://www.brevo.com
#   2. Verify the sender address you want to send FROM
#      (Senders, Domains & Dedicated IPs -> Senders -> Add a sender).
#      Put that exact address in DJANGO_DEFAULT_FROM_EMAIL below.
#   3. Open SMTP & API -> SMTP and generate a new SMTP key.
#      - "Login" goes into DJANGO_EMAIL_HOST_USER
#        (it looks like 9a1b2c001@smtp-brevo.com, it is NOT your
#         Brevo account email)
#      - the generated key goes into DJANGO_EMAIL_HOST_PASSWORD
#   4. Deploy, then verify with:
#        python manage.py send_test_email you@example.com --show-config
#
# Gmail alternative (fine for a handful of test users, but Google
# throttles it and messages are more likely to land in spam):
#   DJANGO_EMAIL_HOST=smtp.gmail.com
#   DJANGO_EMAIL_HOST_USER=your.address@gmail.com
#   DJANGO_EMAIL_HOST_PASSWORD=<16-character App Password>
#   Requires 2-Step Verification enabled on the Google account; a
#   normal account password will NOT work.
#
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

DJANGO_EMAIL_HOST=smtp-relay.brevo.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0

DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=

DJANGO_DEFAULT_FROM_EMAIL="AeroESP <noreply@example.com>"
DJANGO_EMAIL_TIMEOUT=20


DJANGO_LOG_LEVEL=INFO


DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0