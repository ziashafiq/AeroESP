DJANGO_ENV=production
DJANGO_DEBUG=0

DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com


# postgresql (default) or sqlite
AEROESP_DB_BACKEND=postgresql

# TLS to the database is chosen automatically: "require" for a host
# reached over the internet, "prefer" for one on a private network
# (a bare service name such as Liara's "aeroesp", or a private IP).
# Set this only to override that, e.g. AEROESP_DB_SSLMODE=disable.
# AEROESP_DB_SSLMODE=

AEROESP_DB_NAME=aeroesp_production
AEROESP_DB_USER=aeroesp_prod_user
AEROESP_DB_PASSWORD=
AEROESP_DB_HOST=127.0.0.1
AEROESP_DB_PORT=5432


AEROESP_SECRET_KEY=


AEROESP_AI_PROVIDER=BASELINE_V1

AEROESP_OPENAI_MODEL=
AEROESP_DEEPSEEK_MODEL=deepseek-chat


# =========================================================
# Email (REQUIRED - account verification codes depend on it)
# =========================================================
#
# Configured provider: Gmail SMTP.
#
#   1. The Google account MUST have 2-Step Verification enabled.
#      Without it, App Passwords do not exist as an option.
#   2. Go to https://myaccount.google.com/apppasswords and create an
#      App Password. Google shows it as four groups of four letters,
#      e.g. "abcd efgh ijkl mnop".
#   3. DJANGO_EMAIL_HOST_USER  = the full Gmail address
#      DJANGO_EMAIL_HOST_PASSWORD = that App Password
#      (spaces are tolerated - settings.py strips them - but the
#       normal account password will NOT work)
#   4. DJANGO_DEFAULT_FROM_EMAIL must use the same Gmail address:
#      Gmail rewrites or rejects any other sender.
#   5. Verify after deploying:
#        python manage.py send_test_email you@example.com --show-config
#
# Limits: roughly 500 recipients/day, and Google may throttle or
# challenge a server that suddenly starts sending from a new country.
# Good enough for pilot users; move to a transactional provider before
# opening registration widely.
#
# ---------------------------------------------------------
# Alternative: Brevo (free tier, 300 emails/day, better inbox
# placement and a sender address on your own domain).
#   DJANGO_EMAIL_HOST=smtp-relay.brevo.com
#   DJANGO_EMAIL_HOST_USER=<SMTP login from SMTP & API -> SMTP,
#                            looks like 9a1b2c001@smtp-brevo.com,
#                            NOT your Brevo account email>
#   DJANGO_EMAIL_HOST_PASSWORD=<generated SMTP key>
#   DJANGO_DEFAULT_FROM_EMAIL must be a sender verified in Brevo.
# ---------------------------------------------------------
#
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0

DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=

DJANGO_DEFAULT_FROM_EMAIL="AeroESP <your.address@gmail.com>"
DJANGO_EMAIL_TIMEOUT=20


DJANGO_LOG_LEVEL=INFO


DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0