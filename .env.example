# =========================================================
# Django Core Settings
# =========================================================

DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO


# =========================================================
# Database
# =========================================================

AEROESP_DB_BACKEND=postgresql
AEROESP_DB_NAME=aeroesp
AEROESP_DB_USER=aeroesp_user
AEROESP_DB_PASSWORD=CHANGE_ME
AEROESP_DB_HOST=localhost
AEROESP_DB_PORT=5432


# =========================================================
# AI / Intelligence
# =========================================================

AEROESP_AI_PROVIDER=BASELINE_V1
AEROESP_OPENAI_MODEL=gpt-5.6-luna
AEROESP_OPENAI_TIMEOUT=45
OPENAI_API_KEY=


# =========================================================
# Production Overrides
# =========================================================

# DJANGO_ENV=production
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<strong-secret>
# DJANGO_ALLOWED_HOSTS=yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# AEROESP_DB_PASSWORD=<strong-password>
# OPENAI_API_KEY=<your-api-key>