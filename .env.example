DJANGO_ENV=development
DJANGO_DEBUG=1

DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000


# postgresql (default) or sqlite
AEROESP_DB_BACKEND=sqlite

AEROESP_DB_NAME=aeroesp
AEROESP_DB_USER=aeroesp_user
AEROESP_DB_PASSWORD=
AEROESP_DB_HOST=localhost
AEROESP_DB_PORT=5432


AEROESP_SECRET_KEY=


AEROESP_AI_PROVIDER=BASELINE_V1

AEROESP_OPENAI_MODEL=
AEROESP_DEEPSEEK_MODEL=deepseek-chat


# =========================================================
# Email
# =========================================================
#
# Local development: the console backend prints messages to the
# terminal instead of sending them. That is usually what you want here.
#
# To test real delivery locally, switch the backend to SMTP and fill in
# the Brevo values below, then run:
#
#   python manage.py send_test_email you@example.com --show-config
#
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Brevo SMTP (see deployment/production.env.example for details) ---
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp-relay.brevo.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0

# Brevo: the SMTP *login* shown on the SMTP & API page (looks like
# 9a1b2c001@smtp-brevo.com), NOT your Brevo account email.
DJANGO_EMAIL_HOST_USER=

# Brevo: the generated SMTP key. Treat it as a password.
DJANGO_EMAIL_HOST_PASSWORD=

# Must be an address verified with your email provider, otherwise
# the provider rejects the message with a 5.7.0 sender error.
DJANGO_DEFAULT_FROM_EMAIL="AeroESP <noreply@example.com>"

DJANGO_EMAIL_TIMEOUT=20


DJANGO_LOG_LEVEL=INFO


DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0