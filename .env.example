# =========================================================
# AeroESP - local development environment
# =========================================================
#
# Copy to ".env" and fill in what you need:
#
#   cp .env.example .env
#
# ".env" is gitignored and must never be committed. This file is the
# tracked one, so it must stay free of real values - names, defaults
# and comments only.
#
# Every variable below is read by config/settings.py. Anything left
# empty or absent falls back to the default noted in its comment, so a
# blank file still boots a working development server.
#
# To point a single command at another env file (e.g. the production
# database), prefix the command rather than editing this one:
#
#   AEROESP_ENV_FILE=.env.production.local python manage.py shell
#
# AEROESP_ENV_FILE is read from the shell before any file is loaded,
# so setting it inside a .env file has no effect.


# =========================================================
# Core
# =========================================================

# "development" or "production". Drives DEBUG defaults, the security
# headers, and whether missing database credentials are fatal.
DJANGO_ENV=development
DJANGO_DEBUG=1

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000


# =========================================================
# Canonical domain (301 redirects)
# =========================================================

# The apex domain everything else redirects to - no scheme, no "www".
# CanonicalDomainMiddleware is a complete no-op while this is empty,
# which is what you want locally. Default: empty.
AEROESP_CANONICAL_HOST=

# Comma-separated extra hosts that should 301 to the canonical host,
# besides its own www subdomain - typically a platform default address
# such as example.liara.run. Default: empty.
AEROESP_LEGACY_HOSTS=


# =========================================================
# Database
# =========================================================

# postgresql (default) or sqlite. sqlite needs no server and is the
# quickest way to get a local instance running.
AEROESP_DB_BACKEND=sqlite

# Used when AEROESP_DB_BACKEND=postgresql.
AEROESP_DB_NAME=aeroesp
AEROESP_DB_USER=aeroesp_user
AEROESP_DB_PASSWORD=
AEROESP_DB_HOST=localhost
AEROESP_DB_PORT=5432

# A full postgres:// URL, as an alternative to the five settings
# above - if set, it wins and they are ignored. Mainly for hosts that
# hand out one connection string. Default: empty.
DATABASE_URL=

# TLS to the database. Chosen automatically when empty: "require" for
# a host reached over the internet, "prefer" for one on a private
# network (a bare service name such as Liara's "aeroesp", or a private
# IP). Set it only to override that, e.g. "disable".
AEROESP_DB_SSLMODE=

# Seconds to keep a database connection open between requests.
# Defaults to 0 for a loopback host and 60 for anything else, which
# suits a remote database over a slower link. Default: unset.
AEROESP_DB_CONN_MAX_AGE=


# =========================================================
# Application secret
# =========================================================

# A Fernet key used to encrypt stored AI provider API keys. Generate
# with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# It must be the SAME value everywhere that reads the same database,
# or previously stored keys cannot be decrypted.
AEROESP_SECRET_KEY=


# =========================================================
# AI provider
# =========================================================

# BASELINE_V1 uses no external provider and needs no API key.
AEROESP_AI_PROVIDER=BASELINE_V1

AEROESP_OPENAI_MODEL=

# Seconds before an AI request is abandoned. Default: 45.
AEROESP_OPENAI_TIMEOUT=


# =========================================================
# Email
# =========================================================
#
# Local development: the console backend prints messages to the
# terminal instead of sending them. That is usually what you want here.
#
# To test real delivery locally, switch the backend to SMTP and fill in
# the values below, then run:
#
#   python manage.py send_test_email you@example.com --show-config
#
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Gmail SMTP (see deployment/production.env.example for details) ---
# Uncomment the line below to send for real.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0

# The full Gmail address.
DJANGO_EMAIL_HOST_USER=

# A 16-character App Password from
# https://myaccount.google.com/apppasswords - requires 2-Step
# Verification on the account. The normal password will not work.
# Spaces are tolerated; settings.py strips them.
DJANGO_EMAIL_HOST_PASSWORD=

# The From address on every outgoing message.
#
# With Gmail SMTP this only works for an address Gmail is willing to
# send as: the account itself, or one registered under
# Settings -> Accounts -> "Send mail as" and confirmed. A forwarder
# such as ImprovMX routes mail INBOUND to an address and grants no
# right to send FROM it, so a domain address needs that alias step
# before it will stick. Without it Gmail silently rewrites the header
# back to DJANGO_EMAIL_HOST_USER and delivers anyway.
#
# Left empty, settings.py falls back to DJANGO_EMAIL_HOST_USER.
DJANGO_DEFAULT_FROM_EMAIL=

# Sender for error reports Django mails to ADMINS. Falls back to
# DJANGO_DEFAULT_FROM_EMAIL when empty.
DJANGO_SERVER_EMAIL=

# --- Brevo alternative ---
# DJANGO_EMAIL_HOST=smtp-relay.brevo.com
# DJANGO_EMAIL_HOST_USER=<SMTP login, e.g. 9a1b2c001@smtp-brevo.com>
# DJANGO_EMAIL_HOST_PASSWORD=<generated SMTP key>

DJANGO_EMAIL_TIMEOUT=20


# =========================================================
# Registration
# =========================================================

# Set to 0 to let accounts activate without confirming their address.
# Useful locally when no mail backend can actually deliver.
# Default: 1 (verification required).
AEROESP_REQUIRE_EMAIL_VERIFICATION=

# Shown to users when a feature that needs email is unavailable.
# Falls back to DJANGO_EMAIL_HOST_USER when empty.
AEROESP_SUPPORT_EMAIL=

# When set, registration requires this code - the way the closed beta
# stays invite-only without a code change. Empty means registration is
# open. Default: empty.
AEROESP_INVITE_CODE=


# =========================================================
# Logging and security headers
# =========================================================

DJANGO_LOG_LEVEL=INFO

DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
