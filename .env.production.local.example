# =========================================================
# Connect a LOCAL command to the PRODUCTION database
# =========================================================
#
# Copy this file to ".env.production.local" and fill in DATABASE_URL.
# That filename is already covered by .gitignore, so it never reaches
# GitHub. This file (the .example one) must stay free of real values.
#
# Use it for one command at a time:
#
#   AEROESP_ENV_FILE=.env.production.local python manage.py createsuperuser
#   AEROESP_ENV_FILE=.env.production.local python manage.py shell
#
# Without that prefix every command keeps using your normal .env, so
# there is nothing to undo afterwards.
#
# ---------------------------------------------------------
# WARNING
# ---------------------------------------------------------
# Commands run with this file act on real user data. Django prints a
# "*** REMOTE DATABASE ***" banner so you can tell. Read it before you
# press enter, and never run 'flush', 'reset_db' or a destructive
# shell query while it is showing.
# ---------------------------------------------------------


# Render dashboard -> your Postgres instance -> Connections ->
# "External Database URL". Copy the WHOLE line, including
# postgresql:// at the start. The internal URL only works from inside
# Render and will time out from your machine.
DATABASE_URL=

AEROESP_DB_BACKEND=postgresql

# Managed databases require TLS from outside their network. Leave this
# alone unless your provider says otherwise.
AEROESP_DB_SSLMODE=require


# Keep DEBUG on so a mistake surfaces as a readable error rather than
# a generic 500 page. This file is only ever used for local commands,
# never for serving traffic.
DJANGO_ENV=development
DJANGO_DEBUG=1

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost


# Must be the SAME value as on the Render service, otherwise stored
# API keys cannot be decrypted. Copy it from the Render environment
# variables, do not generate a new one.
AEROESP_SECRET_KEY=

# Any value works here; it is not used for connecting to the database.
DJANGO_SECRET_KEY=local-only-key-for-management-commands-0123456789abcd


# Do not send real email from a local admin session.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
